[Unit]
Description=DSE Quantitative Engine — Weekly Knowledge Base Refresh Service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=%i
WorkingDirectory=/path/to/stock_market
Environment="PYTHONUNBUFFERED=1"
Environment="TZ=Asia/Dhaka"
ExecStart=/path/to/stock_market/.venv/bin/python /path/to/stock_market/scripts/analyzer.py category_a weekly
StandardOutput=journal
StandardError=journal
Restart=no

[Install]
WantedBy=multi-user.target
